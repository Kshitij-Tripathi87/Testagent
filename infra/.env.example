# Copy this file to .env and replace the values.
APP_ENV=development
POSTGRES_PASSWORD=testagent-local-only
DATABASE_URL=postgresql+psycopg://testagent:testagent-local-only@localhost:5432/testagent
REDIS_URL=redis://localhost:6379/0

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Development-only header authentication. Set false outside local development.
DEV_AUTH_ENABLED=true
NEXT_PUBLIC_DEV_USER=local-beta-user

# For hosted beta, configure Supabase Auth and disable development identity.
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only hosts explicitly listed here are accepted for DataHub connections
# when APP_ENV=production. Comma-separated hostnames, without scheme.
DATAHUB_ALLOWED_HOSTS=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=25
MAX_LINEAGE_HOPS=5
